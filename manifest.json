{
  "manifest_version": 3,
  "name": "Rover Watch",
  "version": "1.1.0",
  "description": "Advanced real-time email phishing, link analysis, and scam detection for Gmail and Yahoo Mail.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.yahoo.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "roverwatch51@gmail.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "personalCommunications"
        ]
      }
    }
  }
}